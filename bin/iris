#!/bin/bash

# Iris: macOS-style Spotlight Overlay for Omarchy
# Thin wrapper over Omarchy shell IPC, theme sync, and Hyprland keybinding management.

set -euo pipefail

PLUGIN_ID="fickleminded.iris"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

verify_bin_ownership() {
  local target="$1"
  if [ -e "$target" ] || [ -L "$target" ]; then
    if ! grep -F -q "PLUGIN_ID=\"fickleminded.iris\"" "$target" 2>/dev/null && \
       ! grep -F -q "Iris: macOS-style Spotlight Overlay for Omarchy" "$target" 2>/dev/null; then
      echo "iris: refusing to overwrite existing '$target' (not created by $PLUGIN_ID)" >&2
      exit 1
    fi
  fi
}

verify_desktop_ownership() {
  local target="$1"
  if [ -e "$target" ] || [ -L "$target" ]; then
    if ! grep -F -q "X-Omarchy-Plugin-ID=fickleminded.iris" "$target" 2>/dev/null && \
       ! (grep -F -q "Name=Iris" "$target" 2>/dev/null && grep -F -q "Exec=iris toggle" "$target" 2>/dev/null); then
      echo "iris: refusing to overwrite existing '$target' (not created by $PLUGIN_ID)" >&2
      exit 1
    fi
  fi
}

remove_existing_iris_bindings() {
  local file="$1"
  [ -f "$file" ] || return 0

  # Safely remove delimited blocks without risking runaway deletion to EOF
  # if a BEGIN marker exists without a matching END marker.
  local tmp
  tmp="$(mktemp "${file}.tmp.XXXXXX")"
  awk '
    /-- BEGIN fickleminded\.iris/ {
      if (in_block) {
        for (i = 1; i <= buf_len; i++) print buffer[i]
      }
      in_block = 1
      buf_len = 0
      next
    }
    in_block && /-- END fickleminded\.iris/ {
      in_block = 0
      buf_len = 0
      next
    }
    in_block {
      buf_len++
      buffer[buf_len] = $0
      next
    }
    /-- END fickleminded\.iris/ { next }
    { print }
    END {
      if (in_block) {
        for (i = 1; i <= buf_len; i++) print buffer[i]
      }
    }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"

  # Clean up any standalone or legacy iris toggle bindings
  sed -i '/o\.bind(.*"omarchy-shell shell toggle fickleminded\.iris")/d' "$file"
}

install_cli_and_desktop() {
  local target_bin="$HOME/.local/bin/iris"
  local target_desktop="$HOME/.local/share/applications/iris.desktop"

  mkdir -p "$HOME/.local/bin"
  if [ -f "$SCRIPT_DIR/iris" ] && [ "$(realpath "$SCRIPT_DIR/iris" 2>/dev/null)" != "$(realpath "$target_bin" 2>/dev/null)" ]; then
    verify_bin_ownership "$target_bin"
    install -m 755 "$SCRIPT_DIR/iris" "$target_bin"
  fi

  if [ -f "$ROOT_DIR/share/iris.desktop" ] && [ "$(realpath "$ROOT_DIR/share/iris.desktop" 2>/dev/null)" != "$(realpath "$target_desktop" 2>/dev/null)" ]; then
    mkdir -p "$HOME/.local/share/applications"
    verify_desktop_ownership "$target_desktop"
    install -m 644 "$ROOT_DIR/share/iris.desktop" "$target_desktop"
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$HOME/.local/share/applications" || true
  fi
}

build_payload() {
  if [ "$#" -eq 0 ]; then
    echo "{}"
    return
  fi
  local raw="$*"
  if [[ "$raw" =~ ^\{.*\}$ ]]; then
    echo "$raw"
  elif command -v jq >/dev/null 2>&1; then
    jq -nc --arg q "$raw" '{query: $q}'
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c "import sys, json; print(json.dumps({'query': sys.argv[1]}))" "$raw"
  else
    local escaped="${raw//\"/\\\"}"
    echo "{\"query\":\"$escaped\"}"
  fi
}

verb="${1:-toggle}"
shift || true

case "$verb" in
  toggle)
    payload="$(build_payload "$@")"
    exec omarchy-shell shell toggle "$PLUGIN_ID" "$payload"
    ;;
  open | summon)
    payload="$(build_payload "$@")"
    exec omarchy-shell shell summon "$PLUGIN_ID" "$payload"
    ;;
  close | hide)
    exec omarchy-shell shell hide "$PLUGIN_ID"
    ;;
  theme)
    subcmd="${1:-status}"
    CURRENT_THEME="default"
    if command -v omarchy >/dev/null 2>&1; then
      CURRENT_THEME="$(omarchy theme current 2>/dev/null || echo 'default')"
    fi
    echo "• Iris Theme Status:"
    echo "  Active Omarchy Theme: $CURRENT_THEME"
    echo "  Design System: Bound reactively to Omarchy Color and Style tokens."
    if [ "$subcmd" = "sync" ] || [ "$subcmd" = "refresh" ]; then
      if command -v omarchy-shell >/dev/null 2>&1; then
        omarchy-shell -q shell rescanPlugins || true
      fi
      echo "✓ Rescanned plugins and synchronized theme tokens."
    fi
    ;;
  wallpaper | bg)
    subcmd="${1:-next}"
    shift || true
    if [ "$subcmd" = "next" ] || [ "$subcmd" = "cycle" ]; then
      THEME_NAME="$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || echo "")"
      THEME_BACKGROUNDS_PATH="$HOME/.local/state/omarchy/current/theme/backgrounds/"
      USER_BACKGROUNDS_PATH="$HOME/.config/omarchy/backgrounds/$THEME_NAME/"
      CURRENT_BACKGROUND_LINK="$HOME/.local/state/omarchy/current/background"

      mapfile -d '' -t BACKGROUNDS < <(
        find -L "$USER_BACKGROUNDS_PATH" "$THEME_BACKGROUNDS_PATH" -maxdepth 1 -type f \
          \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.webp' \) \
          -print0 2>/dev/null | sort -z
      )
      TOTAL=${#BACKGROUNDS[@]}

      if (( TOTAL == 0 )); then
        command -v omarchy-notification-send >/dev/null 2>&1 && omarchy-notification-send "No background was found for theme" -t 2000 || true
        exit 0
      fi

      CURRENT_REAL="$(realpath "$CURRENT_BACKGROUND_LINK" 2>/dev/null || readlink "$CURRENT_BACKGROUND_LINK" 2>/dev/null || echo "")"

      INDEX=-1
      for i in "${!BACKGROUNDS[@]}"; do
        BG_REAL="$(realpath "${BACKGROUNDS[$i]}" 2>/dev/null || echo "${BACKGROUNDS[$i]}")"
        if [ "$BG_REAL" = "$CURRENT_REAL" ]; then
          INDEX=$i
          break
        fi
      done

      if [ "$INDEX" -eq -1 ]; then
        NEW_BACKGROUND="${BACKGROUNDS[0]}"
      else
        NEXT_INDEX=$(((INDEX + 1) % TOTAL))
        NEW_BACKGROUND="${BACKGROUNDS[$NEXT_INDEX]}"
      fi

      if command -v omarchy-theme-bg-set >/dev/null 2>&1; then
        omarchy-theme-bg-set "$NEW_BACKGROUND"
      elif command -v omarchy >/dev/null 2>&1; then
        omarchy theme bg set "$NEW_BACKGROUND"
      fi
    elif [ "$subcmd" = "picker" ] || [ "$subcmd" = "switcher" ]; then
      exec omarchy theme bg-switcher
    fi
    ;;
  install-cli)
    install_cli_and_desktop
    echo "✓ CLI 'iris' installed to $HOME/.local/bin/iris"
    echo "✓ Desktop launcher registered at $HOME/.local/share/applications/iris.desktop"
    ;;
  setup-keybind | install-keybind)
    install_cli_and_desktop
    KEYBIND="${1:-ALT + SPACE}"
    [ "$KEYBIND" = "{}" ] && KEYBIND="ALT + SPACE"

    if ! echo "$KEYBIND" | grep -qE '^[A-Za-z0-9 _+]+$'; then
      echo "iris: invalid keybind format '$KEYBIND'. Example: 'ALT + SPACE' or 'SUPER + SPACE'." >&2
      exit 1
    fi

    BINDINGS_DIR="$HOME/.config/hypr"
    BINDINGS_FILE="$BINDINGS_DIR/bindings.lua"

    mkdir -p "$BINDINGS_DIR"
    if [ ! -f "$BINDINGS_FILE" ]; then
      if [ -f "/usr/share/omarchy/config/hypr/bindings.lua" ]; then
        cp "/usr/share/omarchy/config/hypr/bindings.lua" "$BINDINGS_FILE"
      else
        cat <<'EOF' > "$BINDINGS_FILE"
-- Keep only your personal keybinding overrides here.
EOF
      fi
    fi

    # Clean existing Iris bindings if present (scoped strictly to fickleminded.iris)
    remove_existing_iris_bindings "$BINDINGS_FILE"

    cat <<EOF >> "$BINDINGS_FILE"

-- BEGIN fickleminded.iris
o.bind("$KEYBIND", "Iris Spotlight overlay", "omarchy-shell shell toggle $PLUGIN_ID")
-- END fickleminded.iris
EOF

    echo "✓ CLI installed to $HOME/.local/bin/iris"
    echo "✓ Global keybinding '$KEYBIND' configured in $BINDINGS_FILE"
    if command -v hyprctl >/dev/null 2>&1; then
      hyprctl reload >/dev/null 2>&1 || true
      echo "✓ Hyprland configuration reloaded."
    fi
    ;;
  remove-keybind | uninstall-keybind)
    BINDINGS_FILE="$HOME/.config/hypr/bindings.lua"
    if [ -f "$BINDINGS_FILE" ]; then
      remove_existing_iris_bindings "$BINDINGS_FILE"
      echo "✓ Iris keybinding removed from $BINDINGS_FILE"
      if command -v hyprctl >/dev/null 2>&1; then
        hyprctl reload >/dev/null 2>&1 || true
        echo "✓ Hyprland configuration reloaded."
      fi
    else
      echo "No bindings file found at $BINDINGS_FILE."
    fi
    ;;
  -h | --help | help)
    cat <<EOF
Usage: iris [COMMAND] [ARGS]

Commands:
  toggle               Toggle the Iris Spotlight overlay (open if closed, close if open)
  open [PAYLOAD]       Summon the overlay, optionally with JSON payload (e.g. '{"query":"notes"}')
  close                Hide/dismiss the overlay
  theme [status|sync]  Display or refresh theme synchronization with Omarchy
  setup-keybind [KEY]  Install CLI and configure global shortcut (default: 'ALT + SPACE')
  remove-keybind       Remove shortcut from ~/.config/hypr/bindings.lua
  install-cli          Install 'iris' binary to ~/.local/bin and desktop file

Examples:
  iris toggle
  iris open '{"query":"firefox"}'
  iris setup-keybind "ALT + SPACE"
EOF
    ;;
  *)
    echo "iris: unknown command '$verb'. Run 'iris --help' for usage." >&2
    exit 1
    ;;
esac
